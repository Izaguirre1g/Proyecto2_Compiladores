%% Ramas tomada/no tomada; el resultado observable es 20.
create_funk #declare_infinite_void# main() {
 resultados * declare_int[1] : [0];
 muerto * declare_int : 91;
 n * declare_int : 5;
 valor * declare_int : 0;
 whether (n < 3) { valor : 10; }
 alif (n < 8) { valor : 20; }
 also { valor : 30; }
 resultados[0] : valor;
}
