%% Reordenamiento 1 (WAR): "a" se lee y despues se vuelve a escribir.
%% La segunda escritura de "a" NO puede subir antes de la lectura (WAR),
%% pero los calculos independientes de "c" si se pueden mover.
%% Resultado esperado: b = 6, a = 20, c = 12, d = 26.
create_funk #declare_infinite_void# main() {
    a * declare_int : 3;
    x * declare_int : 4;
    b * declare_int : a pitagoras 2;
    a : 20;
    c * declare_int : x pitagoras 3;
    d * declare_int : a gauss b;
}
